{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "EventBus": "amqp://localhost"
  },
  "EventBus": {
    "SubscriptionClientName": "eShop"
  },
  "Identity": {
    "Audience": "eshop",
    "Scopes": {
      "orders": "Orders API",
      "webhooks": "Webhooks API"
    }
  },
  "OpenApi": {
    "Endpoint": {
      "Name": "eShop V1"
    },
    "Document": {
      "Description": "The eShop HTTP API: ordering and webhooks registration",
      "Title": "eShop HTTP API",
      "Version": "v1"
    },
    "Auth": {
      "ClientId": "orderingswaggerui",
      "AppName": "eShop Swagger UI"
    }
  },
  "SessionCookieLifetimeMinutes": 60
}
