<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <UserSecretsId>2d86f364-a439-47c5-9468-3b85a7d9a18e</UserSecretsId>
    <Nullable>enable</Nullable>
    <RootNamespace>eShop.WebApp</RootNamespace>

    <!-- Disable RZ10021, which is failing due to a Razor bug, according to Mackinnon. -->
    <NoWarn>$(NoWarn);RZ10021</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\eShop.Contracts\eShop.Contracts.csproj" />
    <ProjectReference Include="..\eShop.ServiceDefaults\eShop.ServiceDefaults.csproj" />
    <ProjectReference Include="..\EventBusRabbitMQ\EventBusRabbitMQ.csproj" />
    <ProjectReference Include="..\WebAppComponents\WebAppComponents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Сервисы-модули. Ссылки нужны, чтобы сборки (и их content) оказались рядом с хостом: какие модули
         загрузятся, решает HOSTINGSTARTUPASSEMBLIES. Псевдоним убирает типы модулей с глаз компилятора хоста -->
    <ProjectReference Include="..\Basket.API\Basket.API.csproj" Aliases="modules" />
    <ProjectReference Include="..\Catalog.API\Catalog.API.csproj" Aliases="modules" />
    <ProjectReference Include="..\Identity.API\Identity.API.csproj" Aliases="modules" />
    <ProjectReference Include="..\Ordering.API\Ordering.API.csproj" Aliases="modules" />
    <ProjectReference Include="..\OrderProcessor\OrderProcessor.csproj" Aliases="modules" />
    <ProjectReference Include="..\PaymentProcessor\PaymentProcessor.csproj" Aliases="modules" />
    <ProjectReference Include="..\Webhooks.API\Webhooks.API.csproj" Aliases="modules" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FusionModules" />
    <PackageReference Include="Asp.Versioning.Http.Client" />
    <PackageReference Include="Aspire.Azure.AI.OpenAI" />
    <PackageReference Include="CommunityToolkit.Aspire.OllamaSharp" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
  </ItemGroup>


</Project>
