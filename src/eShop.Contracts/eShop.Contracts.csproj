<Project Sdk="Microsoft.NET.Sdk">

  <!-- Contracts through which the storefront calls the modules in the same process.
       No dependencies: the host and the modules reference this project, not each other -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
