<Project>

  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <!-- EventSource is disabled by default for non-ASP.NET AOT'd apps, re-enable it -->
    <EventSourceSupport>true</EventSourceSupport>

    <!-- Ensure individual warnings are shown when publishing -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <!-- Топологические тесты называют Program хоста в коде: исполняемые проекты на FusionModules открывают
       внутренние типы (Program из top-level кода) проекту tests/Topology.Tests, отдельный Program.Testing.cs не нужен -->
  <ItemGroup Condition="'$(OutputType)' == 'Exe' And '@(PackageReference->WithMetadataValue('Identity', 'FusionModules')->Count())' != '0'">
    <InternalsVisibleTo Include="Topology.Tests" />
  </ItemGroup>

</Project>
