<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPublishable>false</IsPublishable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FusionModules.Testing" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <!-- У хостов свой Program в глобальном пространстве имён, поэтому у каждой ссылки свой псевдоним:
         тест называет тип хоста через extern alias. Модули - библиотеки, они приезжают как зависимости WebApp -->
    <ProjectReference Include="..\..\src\WebApp\WebApp.csproj" Aliases="webapp" />
    <ProjectReference Include="..\..\src\WebhookClient\WebhookClient.csproj" Aliases="webhookclient" />
  </ItemGroup>

  <ItemGroup>
    <!-- Общая шина: пробе нужен EventBusSubscriptionInfo -->
    <ProjectReference Include="..\..\src\EventBus\EventBus.csproj" />
  </ItemGroup>

</Project>
